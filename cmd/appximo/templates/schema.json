{
  "$schema": "https://appximo.com/schema/v1",
  "version": "1",
  "name": "my-api",
  "resources": {
    "items": {
      "fields": {
        "name":        { "type": "string", "required": true },
        "description": { "type": "text" },
        "created_at":  { "type": "time",   "auto": true },
        "updated_at":  { "type": "time",   "auto": true }
      }
    }
  },
  "rbac": {
    "roles": {
      "admin": { "resources": "*", "actions": ["*"] },
      "viewer": { "resources": "*", "actions": ["read"] }
    }
  }
}
