generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model guides {
  id             Int      @id @default(autoincrement())
  tenantId       String   @map("tenant_id")
  title          String
  content        String
  status         String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, status, createdAt])
  @@map("guides")
}