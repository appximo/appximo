# Binaries
bin/
/appitools
/appitools-worker
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go build cache
*.test
*.out
/vendor/

# Generated by `appitools generate` (engine output — not committed)
internal/ent/
internal/graph/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local build artifacts / rollback binaries
appitools.pre_*
*.bundle

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

benchmark-lab/node_modules/
# Claude Code runtime artifacts
.claude/scheduled_tasks.lock
.claude/scheduled_tasks/

# k6 perf run artifact
tests/performance/last-run.json
tests/performance/last-write-run.json

# DevHub local dev artifacts (S41/S42): the statistics store is a runtime DB
# regenerated from tools/devhub/db/schema.sql; the dev engine + devhub binaries
# are built locally.
tools/devhub/db/*.db
tools/devhub/db/*.db-shm
tools/devhub/db/*.db-wal
/appitools-dev
/devhub

# devhub UI build output (placeholder index.html stays committed for go:embed)
tools/devhub/web/dist/assets/
tools/devhub/web/node_modules/

# admin panel UI build output — SAME pattern as the devhub above (ADMIN-UI-V1):
# the built index.html stays committed so //go:embed web/dist always resolves;
# the hashed assets are produced by `npm run build` (make admin-ui) before go build.
pkg/adminui/web/dist/assets/
pkg/adminui/web/node_modules/

# visual schema editor UI build output — SAME pattern (UI-F0-S1): the built
# build/index.html stays committed so //go:embed all:web/build always resolves;
# the hashed assets are produced by `npm run build` (make editor-ui) before go build.
# (public/favicon.svg is the committed SOURCE; build/favicon.svg is its build copy.)
pkg/editorui/web/build/assets/
pkg/editorui/web/build/favicon.svg
pkg/editorui/web/node_modules/

# Self-restart artifacts (UI-F4-S2): the boot-schema backup + marker written
# next to the --schema file by POST /admin/engine/schema. Never commit them.
*.bak
*.selfrestart
/appitools-spec.md

# Fleet dev scaffold (make fleet-init) — user config + generated secrets/state
/fleet.json
/fleet-secrets/
/fleet-data/
/schemas/

# Per-run output of scripts/verify-production (curated evidence lives in
# benchmarks/data/verify-production-2vcpu-2gb/).
verify-results/
