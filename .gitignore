# Binaries
bin/
/appximo
/appximo-worker
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go build cache
*.test
*.out
/vendor/

# Generated by `appximo generate` (engine output — not committed)
internal/ent/
internal/graph/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local build artifacts / rollback binaries
appximo.pre_*
*.bundle

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

benchmark-lab/node_modules/
# Claude Code runtime artifacts
.claude/scheduled_tasks.lock
.claude/scheduled_tasks/

# k6 perf run artifact
tests/performance/last-run.json
tests/performance/last-write-run.json

# DevHub local dev artifacts (S41/S42): the statistics store is a runtime DB
# regenerated from tools/devhub/db/schema.sql; the dev engine + devhub binaries
# are built locally.
tools/devhub/db/*.db
tools/devhub/db/*.db-shm
tools/devhub/db/*.db-wal
/appximo-dev
/appximo-lab
/devhub

# devhub UI build output (placeholder index.html stays committed for go:embed)
tools/devhub/web/dist/assets/
tools/devhub/web/node_modules/

# admin panel + Studio UI build output: since ADR-025 the BUILT assets are
# COMMITTED (pkg/adminui/web/dist/, pkg/editorui/web/build/) so the published
# module — and any bare `go build` — ships working /admin and /editor (field
# report B1). A session that touches web/src MUST rebuild (make admin-ui /
# editor-ui) and commit the new assets with the src change. Only node_modules
# stays ignored. (tools/devhub above keeps the old placeholder pattern: it is
# an internal dev tool, not part of the module.)
pkg/adminui/web/node_modules/
pkg/editorui/web/node_modules/

# Self-restart artifacts (UI-F4-S2): the boot-schema backup + marker written
# next to the --schema file by POST /admin/engine/schema. Never commit them.
*.bak
*.selfrestart
/appximo-spec.md

# Fleet dev scaffold (make fleet-init) — user config + generated secrets/state
/fleet.json
/fleet-secrets/
/fleet-data/
/schemas/

# Per-run output of scripts/verify-production (curated evidence lives in
# benchmarks/data/verify-production-2vcpu-2gb/).
verify-results/

# the laboratory orchestrator binary (build with: go build -o lab ./tools/lab)
/lab

# tools/capacity build dropped in the root by a lab session (like appximo-lab)
/capacity
