{"id":"timesheet_approval","stratum":"compleja","domain":"hr","description":"A timesheet approval system: employees submit weekly timesheets containing entries; a timesheet moves through draft → submitted → approved/rejected, and rejected returns to draft. An employee reads and edits only its own timesheets, scoped by user_id; a manager reads and approves all.","gold":{"name":"timesheet-api","resources":{"employees":{"fields":{"name":{"type":"string","required":true,"maxLength":160},"user_id":{"type":"uuid","unique":true}}},"timesheets":{"fields":{"employee_id":{"type":"uuid","required":true,"relation":"employees","on_delete":"cascade"},"user_id":{"type":"uuid"},"week_of":{"type":"time","required":true},"status":{"type":"string","enum":["draft","submitted","approved","rejected"],"default":"draft","state_machine":{"initial":"draft","transitions":{"draft":["submitted"],"submitted":["approved","rejected"],"approved":[],"rejected":["draft"]}}}},"relations":{"employee":{"type":"belongs_to","target":"employees","fk":"employee_id"},"entries":{"type":"has_many","target":"entries","fk":"timesheet_id"}},"events":["create","update"]},"entries":{"fields":{"timesheet_id":{"type":"uuid","required":true,"relation":"timesheets","on_delete":"cascade"},"worked_on":{"type":"time","required":true},"hours":{"type":"float64","required":true,"min":0,"max":24},"project":{"type":"string","maxLength":120}}}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"manager":{"resources":["timesheets","entries","employees"],"actions":["read","update"]},"employee":{"permissions":{"timesheets":{"actions":["read","create","update"],"conditions":{"field":"user_id","op":"eq","val":"$user_id"}},"entries":{"actions":["read","create","update"]}}}}},"$schema":"https://appximo.com/schema/v1","version":"1"}}
