{"id":"subscription_box","stratum":"compleja","domain":"ecommerce","description":"A subscription box service: customers subscribe to box plans, and each monthly shipment moves through scheduled → packed → shipped → delivered with a skipped branch. A customer reads its own shipments, scoped by user_id.","gold":{"name":"box-api","resources":{"box_plans":{"fields":{"name":{"type":"string","required":true,"unique":true,"maxLength":120},"price":{"type":"float64","required":true,"min":0},"cadence":{"type":"string","enum":["monthly","quarterly"],"default":"monthly"}}},"subscribers":{"fields":{"name":{"type":"string","required":true,"maxLength":160},"user_id":{"type":"uuid","unique":true},"plan_id":{"type":"uuid","required":true,"relation":"box_plans","on_delete":"restrict"}},"relations":{"plan":{"type":"belongs_to","target":"box_plans","fk":"plan_id"},"shipments":{"type":"has_many","target":"shipments","fk":"subscriber_id"}}},"shipments":{"fields":{"subscriber_id":{"type":"uuid","required":true,"relation":"subscribers","on_delete":"cascade"},"user_id":{"type":"uuid"},"period":{"type":"string","required":true,"pattern":"^[0-9]{4}-[0-9]{2}$"},"status":{"type":"string","enum":["scheduled","packed","shipped","delivered","skipped"],"default":"scheduled","state_machine":{"initial":"scheduled","transitions":{"scheduled":["packed","skipped"],"packed":["shipped"],"shipped":["delivered"],"delivered":[],"skipped":[]}}}},"relations":{"subscriber":{"type":"belongs_to","target":"subscribers","fk":"subscriber_id"}},"events":["create","update"],"indexes":[{"fields":["user_id"]}]}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"fulfillment":{"resources":["shipments","subscribers"],"actions":["read","update"]},"customer":{"permissions":{"box_plans":{"actions":["read"]},"shipments":{"actions":["read"],"conditions":{"field":"user_id","op":"eq","val":"$user_id"}}}}}},"$schema":"https://appitools.dev/schema/v1","version":"1"}}
