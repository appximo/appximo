{"id":"cms","stratum":"compleja","domain":"publishing","description":"A content management system: authors write articles that move through draft → in_review → published → archived (published can go back to draft as unpublish). Articles have many tags through a junction and belong to a category. An author manages only its own articles, scoped by author_id; an editor reads and updates all.","gold":{"name":"cms-api","resources":{"categories":{"fields":{"name":{"type":"string","required":true,"unique":true,"maxLength":80}}},"articles":{"fields":{"category_id":{"type":"uuid","relation":"categories","on_delete":"set_null"},"author_id":{"type":"uuid"},"title":{"type":"string","required":true,"maxLength":200},"slug":{"type":"string","required":true,"unique":true,"pattern":"^[a-z0-9-]+$"},"body":{"type":"text"},"status":{"type":"string","enum":["draft","in_review","published","archived"],"default":"draft","state_machine":{"initial":"draft","transitions":{"draft":["in_review"],"in_review":["published","draft"],"published":["archived","draft"],"archived":[]}}}},"relations":{"category":{"type":"belongs_to","target":"categories","fk":"category_id"},"tags":{"type":"many_to_many","target":"tags","through":"article_tags","fk":"article_id","target_fk":"tag_id"}},"events":["create","update"]},"tags":{"fields":{"name":{"type":"string","required":true,"unique":true,"maxLength":40}}},"article_tags":{"fields":{"article_id":{"type":"uuid","required":true,"relation":"articles","on_delete":"cascade"},"tag_id":{"type":"uuid","required":true,"relation":"tags","on_delete":"cascade"}},"indexes":[{"fields":["article_id","tag_id"],"unique":true}]}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"editor":{"resources":["articles","categories","tags"],"actions":["read","update"]},"author":{"permissions":{"articles":{"actions":["read","create","update","delete"],"conditions":{"field":"author_id","op":"eq","val":"$user_id"}},"categories":{"actions":["read"]},"tags":{"actions":["read"]}}}}},"$schema":"https://appximo.com/schema/v1","version":"1"}}
