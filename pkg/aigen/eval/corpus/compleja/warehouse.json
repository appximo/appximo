{"id":"warehouse","stratum":"compleja","domain":"logistics","description":"A multi-warehouse inventory: warehouses have branches identified by a composite (region_code, branch_code) unique key; stock items reference a branch via a composite foreign key. Pickers read stock and create movements.","gold":{"name":"warehouse-api","resources":{"branches":{"fields":{"region_code":{"type":"string","required":true,"pattern":"^[A-Z]{2,4}$"},"branch_code":{"type":"string","required":true,"pattern":"^[0-9]{2,5}$"},"name":{"type":"string","required":true,"maxLength":120}},"indexes":[{"fields":["region_code","branch_code"],"unique":true}]},"stock":{"fields":{"region_code":{"type":"string","required":true},"branch_code":{"type":"string","required":true},"sku":{"type":"string","required":true,"maxLength":40},"quantity":{"type":"int","min":0,"default":0}},"foreign_keys":[{"columns":["region_code","branch_code"],"target":"branches","ref_columns":["region_code","branch_code"],"on_delete":"cascade","on_update":"cascade"}],"indexes":[{"fields":["sku"]}]},"movements":{"fields":{"sku":{"type":"string","required":true,"maxLength":40},"delta":{"type":"int","required":true},"reason":{"type":"string","enum":["inbound","outbound","transfer","adjust"],"default":"adjust"},"created_at":{"type":"time","auto":true}}}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"picker":{"resources":["stock","movements"],"actions":["read","create"]}}},"$schema":"https://appximo.com/schema/v1","version":"1"}}
