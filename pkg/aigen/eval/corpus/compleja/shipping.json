{"id":"shipping","stratum":"compleja","domain":"logistics","description":"A shipping system: carriers serve routes identified by a composite (origin_port, dest_port) unique key; shipments reference a route via a composite foreign key and move through booked → in_transit → arrived → delivered. An ops role manages shipments.","gold":{"name":"shipping-api","resources":{"routes":{"fields":{"origin_port":{"type":"string","required":true,"pattern":"^[A-Z]{3,5}$"},"dest_port":{"type":"string","required":true,"pattern":"^[A-Z]{3,5}$"},"transit_days":{"type":"int","min":1}},"indexes":[{"fields":["origin_port","dest_port"],"unique":true}]},"carriers":{"fields":{"name":{"type":"string","required":true,"unique":true,"maxLength":120}}},"shipments":{"fields":{"carrier_id":{"type":"uuid","required":true,"relation":"carriers","on_delete":"restrict"},"origin_port":{"type":"string","required":true},"dest_port":{"type":"string","required":true},"tracking_no":{"type":"string","required":true,"unique":true,"maxLength":40},"status":{"type":"string","enum":["booked","in_transit","arrived","delivered"],"default":"booked","state_machine":{"initial":"booked","transitions":{"booked":["in_transit"],"in_transit":["arrived"],"arrived":["delivered"],"delivered":[]}}}},"foreign_keys":[{"columns":["origin_port","dest_port"],"target":"routes","ref_columns":["origin_port","dest_port"],"on_delete":"restrict","on_update":"cascade"}],"events":["create","update"]}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"ops":{"resources":["routes","carriers","shipments"],"actions":["read","create","update"]}}},"$schema":"https://appximo.com/schema/v1","version":"1"}}
