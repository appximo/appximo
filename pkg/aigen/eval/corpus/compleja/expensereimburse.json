{"id":"grants","stratum":"compleja","domain":"nonprofit","description":"A grants management system: organizations apply for grant programs; an application moves through submitted → reviewed → awarded/declined, and awarded grants record disbursements. A reviewer reads programs and updates applications; an applicant reads its own applications, scoped by user_id.","gold":{"name":"grants-api","resources":{"programs":{"fields":{"name":{"type":"string","required":true,"unique":true,"maxLength":200},"budget":{"type":"float64","min":0},"open":{"type":"bool","default":true}},"relations":{"applications":{"type":"has_many","target":"applications","fk":"program_id"}}},"applications":{"fields":{"program_id":{"type":"uuid","required":true,"relation":"programs","on_delete":"cascade"},"user_id":{"type":"uuid"},"organization":{"type":"string","required":true,"maxLength":200},"amount_requested":{"type":"float64","required":true,"min":0},"status":{"type":"string","enum":["submitted","reviewed","awarded","declined"],"default":"submitted","state_machine":{"initial":"submitted","transitions":{"submitted":["reviewed"],"reviewed":["awarded","declined"],"awarded":[],"declined":[]}}}},"relations":{"program":{"type":"belongs_to","target":"programs","fk":"program_id"},"disbursements":{"type":"has_many","target":"disbursements","fk":"application_id"}},"events":["create","update"]},"disbursements":{"fields":{"application_id":{"type":"uuid","required":true,"relation":"applications","on_delete":"cascade"},"amount":{"type":"float64","required":true,"min":0},"paid_on":{"type":"time","required":true}}}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"reviewer":{"resources":["programs","applications"],"actions":["read","update"]},"applicant":{"permissions":{"programs":{"actions":["read"]},"applications":{"actions":["read","create"],"conditions":{"field":"user_id","op":"eq","val":"$user_id"}}}}}},"$schema":"https://appitools.dev/schema/v1","version":"1"}}
