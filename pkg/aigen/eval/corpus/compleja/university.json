{"id":"university","stratum":"compleja","domain":"education","description":"A university registrar: departments offer course sections identified by a composite (dept_code, section_code) unique key; enrollments reference a section via a composite foreign key and carry a grade. A student reads sections and its own enrollments, scoped by user_id.","gold":{"name":"university-api","resources":{"sections":{"fields":{"dept_code":{"type":"string","required":true,"pattern":"^[A-Z]{2,4}$"},"section_code":{"type":"string","required":true,"pattern":"^[0-9]{3,5}$"},"title":{"type":"string","required":true,"maxLength":200},"capacity":{"type":"int","min":1,"max":1000}},"indexes":[{"fields":["dept_code","section_code"],"unique":true}]},"students":{"fields":{"name":{"type":"string","required":true,"maxLength":160},"user_id":{"type":"uuid","unique":true}}},"enrollments":{"fields":{"student_id":{"type":"uuid","required":true,"relation":"students","on_delete":"cascade"},"user_id":{"type":"uuid"},"dept_code":{"type":"string","required":true},"section_code":{"type":"string","required":true},"grade":{"type":"string","enum":["A","B","C","D","F","I"]},"status":{"type":"string","enum":["registered","completed","withdrawn"],"default":"registered","state_machine":{"initial":"registered","transitions":{"registered":["completed","withdrawn"],"completed":[],"withdrawn":[]}}}},"foreign_keys":[{"columns":["dept_code","section_code"],"target":"sections","ref_columns":["dept_code","section_code"],"on_delete":"restrict"}],"indexes":[{"fields":["user_id"]}]}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"registrar":{"resources":["sections","students","enrollments"],"actions":["read","create","update"]},"student":{"permissions":{"sections":{"actions":["read"]},"enrollments":{"actions":["read"],"conditions":{"field":"user_id","op":"eq","val":"$user_id"}}}}}},"$schema":"https://appitools.dev/schema/v1","version":"1"}}
