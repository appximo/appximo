{"id":"assettracking","stratum":"compleja","domain":"operations","description":"An IT asset tracking system: assets are assigned to employees through assignments, and an asset moves through in_stock → assigned → in_repair → retired. An employee reads its own assignments, scoped by user_id.","gold":{"name":"assets-api","resources":{"employees":{"fields":{"name":{"type":"string","required":true,"maxLength":160},"user_id":{"type":"uuid","unique":true},"department":{"type":"string","maxLength":80}}},"assets":{"fields":{"tag":{"type":"string","required":true,"unique":true,"maxLength":40},"kind":{"type":"string","enum":["laptop","monitor","phone","tablet","other"],"default":"laptop"},"status":{"type":"string","enum":["in_stock","assigned","in_repair","retired"],"default":"in_stock","state_machine":{"initial":"in_stock","transitions":{"in_stock":["assigned","in_repair","retired"],"assigned":["in_stock","in_repair"],"in_repair":["in_stock","retired"],"retired":[]}}}},"relations":{"assignments":{"type":"has_many","target":"assignments","fk":"asset_id"}},"events":["create","update"]},"assignments":{"fields":{"asset_id":{"type":"uuid","required":true,"relation":"assets","on_delete":"cascade"},"employee_id":{"type":"uuid","required":true,"relation":"employees","on_delete":"cascade"},"user_id":{"type":"uuid"},"assigned_on":{"type":"time","required":true},"returned_on":{"type":"time"}}}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"it":{"resources":["assets","assignments","employees"],"actions":["read","create","update"]},"employee":{"permissions":{"assignments":{"actions":["read"],"conditions":{"field":"user_id","op":"eq","val":"$user_id"}}}}}},"$schema":"https://appximo.com/schema/v1","version":"1"}}
