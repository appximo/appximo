{"id":"returns_rma","stratum":"compleja","domain":"ecommerce","description":"A returns/RMA system: customers request returns for purchased items; an RMA moves through requested → authorized → received → refunded with a denied branch. A customer reads its own RMAs, scoped by user_id.","gold":{"name":"rma-api","resources":{"products":{"fields":{"sku":{"type":"string","required":true,"unique":true,"maxLength":40},"name":{"type":"string","required":true,"maxLength":160}}},"rmas":{"fields":{"product_id":{"type":"uuid","required":true,"relation":"products","on_delete":"restrict"},"user_id":{"type":"uuid"},"reason":{"type":"string","required":true,"enum":["defective","wrong_item","not_needed","damaged"]},"status":{"type":"string","enum":["requested","authorized","received","refunded","denied"],"default":"requested","state_machine":{"initial":"requested","transitions":{"requested":["authorized","denied"],"authorized":["received","denied"],"received":["refunded"],"refunded":[],"denied":[]}}},"refund_amount":{"type":"float64","min":0},"created_at":{"type":"time","auto":true}},"relations":{"product":{"type":"belongs_to","target":"products","fk":"product_id"}},"events":["create","update"],"indexes":[{"fields":["user_id"]}]}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"support":{"resources":["rmas","products"],"actions":["read","update"]},"customer":{"permissions":{"products":{"actions":["read"]},"rmas":{"actions":["read","create"],"conditions":{"field":"user_id","op":"eq","val":"$user_id"}}}}}},"$schema":"https://appitools.dev/schema/v1","version":"1"}}
