{"id":"insurance","stratum":"compleja","domain":"insurance","description":"An insurance system: policyholders hold policies, and claims against a policy move through submitted → under_review → approved/denied → paid (paid only from approved). A holder reads its own policies and claims, scoped by user_id.","gold":{"name":"insurance-api","resources":{"holders":{"fields":{"name":{"type":"string","required":true,"maxLength":160},"document":{"type":"string","required":true,"unique":true}}},"policies":{"fields":{"holder_id":{"type":"uuid","required":true,"relation":"holders","on_delete":"restrict"},"user_id":{"type":"uuid"},"policy_no":{"type":"string","required":true,"unique":true,"pattern":"^POL-[0-9]{6,10}$"},"kind":{"type":"string","enum":["auto","home","life","health"],"default":"auto"},"premium":{"type":"float64","required":true,"min":0}},"relations":{"holder":{"type":"belongs_to","target":"holders","fk":"holder_id"},"claims":{"type":"has_many","target":"claims","fk":"policy_id"}}},"claims":{"fields":{"policy_id":{"type":"uuid","required":true,"relation":"policies","on_delete":"cascade"},"user_id":{"type":"uuid"},"amount":{"type":"float64","required":true,"min":0},"status":{"type":"string","enum":["submitted","under_review","approved","denied","paid"],"default":"submitted","state_machine":{"initial":"submitted","transitions":{"submitted":["under_review"],"under_review":["approved","denied"],"approved":["paid"],"denied":[],"paid":[]}}},"created_at":{"type":"time","auto":true}},"events":["create","update"]}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"adjuster":{"resources":["policies","claims","holders"],"actions":["read","update"]},"holder":{"permissions":{"policies":{"actions":["read"],"conditions":{"field":"user_id","op":"eq","val":"$user_id"}},"claims":{"actions":["read","create"],"conditions":{"field":"user_id","op":"eq","val":"$user_id"}}}}}},"$schema":"https://appitools.dev/schema/v1","version":"1"}}
