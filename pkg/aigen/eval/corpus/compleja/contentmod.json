{"id":"content_moderation","stratum":"compleja","domain":"community","description":"A content moderation queue: users submit posts, reports flag posts, and a report moves through pending → reviewing → actioned/dismissed. A moderator reads and updates reports; a member reads its own posts, scoped by author_id.","gold":{"name":"moderation-api","resources":{"posts":{"fields":{"author_id":{"type":"uuid"},"body":{"type":"text","required":true},"hidden":{"type":"bool","default":false},"created_at":{"type":"time","auto":true}},"relations":{"reports":{"type":"has_many","target":"reports","fk":"post_id"}}},"reports":{"fields":{"post_id":{"type":"uuid","required":true,"relation":"posts","on_delete":"cascade"},"reason":{"type":"string","required":true,"enum":["spam","abuse","nsfw","other"]},"status":{"type":"string","enum":["pending","reviewing","actioned","dismissed"],"default":"pending","state_machine":{"initial":"pending","transitions":{"pending":["reviewing"],"reviewing":["actioned","dismissed"],"actioned":[],"dismissed":[]}}},"created_at":{"type":"time","auto":true}},"relations":{"post":{"type":"belongs_to","target":"posts","fk":"post_id"}},"events":["create","update"]}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"moderator":{"resources":["posts","reports"],"actions":["read","update"]},"member":{"permissions":{"posts":{"actions":["read","create"],"conditions":{"field":"author_id","op":"eq","val":"$user_id"}},"reports":{"actions":["create"]}}}}},"$schema":"https://appitools.dev/schema/v1","version":"1"}}
