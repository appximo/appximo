{"id":"airline","stratum":"compleja","domain":"travel","description":"An airline booking system: flights have seats, passengers make bookings, and a booking moves through held → confirmed → checked_in → flown, with held → expired and confirmed → cancelled. A passenger reads its own bookings, scoped by user_id.","gold":{"name":"airline-api","resources":{"flights":{"fields":{"flight_no":{"type":"string","required":true,"unique":true,"pattern":"^[A-Z]{2}[0-9]{2,4}$"},"origin":{"type":"string","required":true,"pattern":"^[A-Z]{3}$"},"destination":{"type":"string","required":true,"pattern":"^[A-Z]{3}$"},"departs_at":{"type":"time","required":true},"seats_total":{"type":"int","min":1}},"relations":{"bookings":{"type":"has_many","target":"bookings","fk":"flight_id"}}},"passengers":{"fields":{"name":{"type":"string","required":true,"maxLength":160},"passport":{"type":"string","required":true,"unique":true}}},"bookings":{"fields":{"flight_id":{"type":"uuid","required":true,"relation":"flights","on_delete":"restrict"},"passenger_id":{"type":"uuid","required":true,"relation":"passengers","on_delete":"restrict"},"user_id":{"type":"uuid"},"seat":{"type":"string","maxLength":4},"status":{"type":"string","enum":["held","confirmed","checked_in","flown","expired","cancelled"],"default":"held","state_machine":{"initial":"held","transitions":{"held":["confirmed","expired"],"confirmed":["checked_in","cancelled"],"checked_in":["flown"],"flown":[],"expired":[],"cancelled":[]}}},"created_at":{"type":"time","auto":true}},"relations":{"flight":{"type":"belongs_to","target":"flights","fk":"flight_id"},"passenger":{"type":"belongs_to","target":"passengers","fk":"passenger_id"}},"events":["create","update"]}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"agent":{"resources":["flights","passengers","bookings"],"actions":["read","create","update"]},"passenger":{"permissions":{"flights":{"actions":["read"]},"bookings":{"actions":["read"],"conditions":{"field":"user_id","op":"eq","val":"$user_id"}}}}}},"$schema":"https://appitools.dev/schema/v1","version":"1"}}
