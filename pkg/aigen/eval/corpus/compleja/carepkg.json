{"id":"loan_origination","stratum":"compleja","domain":"fintech","description":"A loan origination system: applicants submit loan applications that move through submitted → underwriting → approved/declined → disbursed (disbursed only from approved). Repayments belong to a disbursed loan. An applicant reads its own applications, scoped by user_id.","gold":{"name":"loans-api","resources":{"applicants":{"fields":{"name":{"type":"string","required":true,"maxLength":160},"document":{"type":"string","required":true,"unique":true},"credit_score":{"type":"int","min":300,"max":850}}},"applications":{"fields":{"applicant_id":{"type":"uuid","required":true,"relation":"applicants","on_delete":"cascade"},"user_id":{"type":"uuid"},"amount":{"type":"float64","required":true,"min":0},"term_months":{"type":"int","required":true,"min":1,"max":480},"status":{"type":"string","enum":["submitted","underwriting","approved","declined","disbursed"],"default":"submitted","state_machine":{"initial":"submitted","transitions":{"submitted":["underwriting"],"underwriting":["approved","declined"],"approved":["disbursed"],"declined":[],"disbursed":[]}}},"created_at":{"type":"time","auto":true}},"relations":{"applicant":{"type":"belongs_to","target":"applicants","fk":"applicant_id"},"repayments":{"type":"has_many","target":"repayments","fk":"application_id"}},"events":["create","update"]},"repayments":{"fields":{"application_id":{"type":"uuid","required":true,"relation":"applications","on_delete":"cascade"},"amount":{"type":"float64","required":true,"min":0},"due_on":{"type":"time","required":true},"paid":{"type":"bool","default":false}}}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"underwriter":{"resources":["applications","applicants","repayments"],"actions":["read","update"]},"applicant":{"permissions":{"applications":{"actions":["read","create"],"conditions":{"field":"user_id","op":"eq","val":"$user_id"}}}}}},"$schema":"https://appitools.dev/schema/v1","version":"1"}}
