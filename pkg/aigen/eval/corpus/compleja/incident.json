{"id":"incident_mgmt","stratum":"compleja","domain":"operations","description":"An incident management system: services have incidents that move through detected → investigating → identified → monitoring → resolved. Updates are posted to an incident. An on-call engineer reads services and manages incidents.","gold":{"name":"incident-api","resources":{"services":{"fields":{"name":{"type":"string","required":true,"unique":true,"maxLength":120},"tier":{"type":"int","min":1,"max":4,"default":2}},"relations":{"incidents":{"type":"has_many","target":"incidents","fk":"service_id"}}},"incidents":{"fields":{"service_id":{"type":"uuid","required":true,"relation":"services","on_delete":"cascade"},"title":{"type":"string","required":true,"maxLength":200},"severity":{"type":"string","enum":["sev1","sev2","sev3","sev4"],"default":"sev3"},"status":{"type":"string","enum":["detected","investigating","identified","monitoring","resolved"],"default":"detected","state_machine":{"initial":"detected","transitions":{"detected":["investigating"],"investigating":["identified"],"identified":["monitoring"],"monitoring":["resolved","investigating"],"resolved":[]}}},"created_at":{"type":"time","auto":true}},"relations":{"service":{"type":"belongs_to","target":"services","fk":"service_id"},"updates":{"type":"has_many","target":"updates","fk":"incident_id"}},"events":["create","update"]},"updates":{"fields":{"incident_id":{"type":"uuid","required":true,"relation":"incidents","on_delete":"cascade"},"body":{"type":"text","required":true},"created_at":{"type":"time","auto":true}}}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"oncall":{"resources":["services","incidents","updates"],"actions":["read","create","update"]},"viewer":{"resources":"*","actions":["read"]}}},"$schema":"https://appximo.com/schema/v1","version":"1"}}
