{"id":"delivery","stratum":"compleja","domain":"logistics","description":"A delivery service: customers place orders that a courier delivers; an order moves through placed → assigned → picked_up → delivered, with a failed branch. Tracking events log each scan. A customer reads its own orders, scoped by user_id.","gold":{"name":"delivery-api","resources":{"couriers":{"fields":{"name":{"type":"string","required":true,"maxLength":120},"phone":{"type":"string","maxLength":40},"active":{"type":"bool","default":true}}},"orders":{"fields":{"courier_id":{"type":"uuid","relation":"couriers","on_delete":"set_null"},"user_id":{"type":"uuid"},"pickup_address":{"type":"string","required":true,"maxLength":200},"dropoff_address":{"type":"string","required":true,"maxLength":200},"status":{"type":"string","enum":["placed","assigned","picked_up","delivered","failed"],"default":"placed","state_machine":{"initial":"placed","transitions":{"placed":["assigned","failed"],"assigned":["picked_up","failed"],"picked_up":["delivered","failed"],"delivered":[],"failed":[]}}},"created_at":{"type":"time","auto":true}},"relations":{"courier":{"type":"belongs_to","target":"couriers","fk":"courier_id"},"events":{"type":"has_many","target":"tracking_events","fk":"order_id"}},"events":["create","update"],"indexes":[{"fields":["status"]},{"fields":["user_id"]}]},"tracking_events":{"fields":{"order_id":{"type":"uuid","required":true,"relation":"orders","on_delete":"cascade"},"location":{"type":"string","maxLength":160},"note":{"type":"string","maxLength":200},"scanned_at":{"type":"time","auto":true}},"relations":{"order":{"type":"belongs_to","target":"orders","fk":"order_id"}}}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"dispatcher":{"resources":["couriers","orders","tracking_events"],"actions":["read","create","update"]},"customer":{"permissions":{"orders":{"actions":["read","create"],"conditions":{"field":"user_id","op":"eq","val":"$user_id"}}}}}},"$schema":"https://appitools.dev/schema/v1","version":"1"}}
