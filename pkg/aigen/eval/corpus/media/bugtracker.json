{"id":"bugtracker","stratum":"media","domain":"developer","description":"A bug tracker: projects have many issues, and issues have many comments. A reporter reads projects and creates issues and comments.","gold":{"name":"bugtracker-api","resources":{"projects":{"fields":{"key":{"type":"string","required":true,"unique":true,"pattern":"^[A-Z]{2,6}$"},"name":{"type":"string","required":true,"maxLength":120}},"relations":{"issues":{"type":"has_many","target":"issues","fk":"project_id"}}},"issues":{"fields":{"project_id":{"type":"uuid","required":true,"relation":"projects","on_delete":"cascade"},"title":{"type":"string","required":true,"maxLength":200},"severity":{"type":"string","enum":["trivial","minor","major","critical"],"default":"minor"},"status":{"type":"string","enum":["open","in_progress","resolved","closed"],"default":"open"}},"relations":{"project":{"type":"belongs_to","target":"projects","fk":"project_id"},"comments":{"type":"has_many","target":"comments","fk":"issue_id"}}},"comments":{"fields":{"issue_id":{"type":"uuid","required":true,"relation":"issues","on_delete":"cascade"},"author":{"type":"string","required":true,"maxLength":120},"body":{"type":"text","required":true},"created_at":{"type":"time","auto":true}},"relations":{"issue":{"type":"belongs_to","target":"issues","fk":"issue_id"}}}},"rbac":{"roles":{"admin":{"resources":"*","actions":["*"]},"reporter":{"resources":["projects","issues","comments"],"actions":["read","create"]}}},"$schema":"https://appitools.dev/schema/v1","version":"1"}}
