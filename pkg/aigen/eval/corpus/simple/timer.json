{
  "id": "timer",
  "stratum": "simple",
  "domain": "productivity",
  "description": "A time-logging tool: time entries with a task name, minutes spent and a date.",
  "gold": {
    "name": "timelog-api",
    "resources": {
      "entries": {
        "fields": {
          "task": {
            "type": "string",
            "required": true,
            "maxLength": 120
          },
          "minutes": {
            "type": "int",
            "required": true,
            "min": 1,
            "max": 1440
          },
          "logged_on": {
            "type": "time",
            "required": true
          }
        }
      }
    },
    "rbac": {
      "roles": {
        "admin": {
          "resources": "*",
          "actions": [
            "*"
          ]
        }
      }
    },
    "$schema": "https://appximo.com/schema/v1",
    "version": "1"
  }
}