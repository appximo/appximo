{
  "id": "bookmarks",
  "stratum": "simple",
  "domain": "productivity",
  "description": "A bookmark manager: bookmarks with a url, a title and a tag.",
  "gold": {
    "name": "bookmarks-api",
    "resources": {
      "bookmarks": {
        "fields": {
          "url": {
            "type": "string",
            "required": true,
            "format": "url"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "tag": {
            "type": "string",
            "maxLength": 40
          }
        }
      }
    },
    "rbac": {
      "roles": {
        "admin": {
          "resources": "*",
          "actions": [
            "*"
          ]
        }
      }
    },
    "$schema": "https://appitools.dev/schema/v1",
    "version": "1"
  }
}