{
  "id": "polls",
  "stratum": "simple",
  "domain": "social",
  "description": "A simple poll: polls with a question, and options each with a label and a count.",
  "gold": {
    "name": "polls-api",
    "resources": {
      "polls": {
        "fields": {
          "question": {
            "type": "string",
            "required": true,
            "maxLength": 200
          },
          "closed": {
            "type": "bool",
            "default": false
          }
        }
      },
      "options": {
        "fields": {
          "label": {
            "type": "string",
            "required": true,
            "maxLength": 80
          },
          "count": {
            "type": "int",
            "min": 0,
            "default": 0
          }
        }
      }
    },
    "rbac": {
      "roles": {
        "admin": {
          "resources": "*",
          "actions": [
            "*"
          ]
        }
      }
    },
    "$schema": "https://appitools.dev/schema/v1",
    "version": "1"
  }
}