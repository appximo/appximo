{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appximo.com/meta/appximo.schema.json",
  "title": "Appximo schema (meta-schema)",
  "description": "Formal JSON Schema (Draft 2020-12) for an Appximo project schema. It mirrors the STRUCTURAL rules the Go validator (pkg/schema) enforces — types, enums, name patterns, allowed keys (strict), required fields, and the two RBAC forms. It is the deterministic structural net: a document that passes this meta-schema is structurally valid; the Go validator remains the authority for SEMANTIC cross-reference checks JSON Schema cannot express (e.g. a relation/FK target or references column must EXIST and be unique on the target; a condition/allowlist field must exist on the resource; renamed_from must not still be declared). See docs/SCHEMA_REFERENCE.md.",
  "type": "object",
  "required": ["$schema", "version"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "description": "Schema dialect URL (any non-empty string; conventionally https://appximo.com/schema/v1)." },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "resources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "not": { "anyOf": [ { "pattern": "^auth_" }, { "const": "transaction" } ] }
      },
      "additionalProperties": { "$ref": "#/$defs/resource" }
    },
    "rbac": { "$ref": "#/$defs/rbac" },
    "workflows": {
      "type": "object",
      "description": "Reserved (parsed for forward-compat; no executor runs it).",
      "additionalProperties": { "$ref": "#/$defs/workflow" }
    }
  },

  "$defs": {
    "ident": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Lowercase identifier: start with a letter, then [a-z0-9_]."
    },

    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "hooks": { "$ref": "#/$defs/hooks" },
        "indexes": { "type": "array", "items": { "$ref": "#/$defs/index" } },
        "events": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["create", "update", "delete"] }
        },
        "relations": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/relation" }
        },
        "renamed_from": { "$ref": "#/$defs/ident" },
        "foreign_keys": { "type": "array", "items": { "$ref": "#/$defs/foreignKey" } }
      }
    },

    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "text", "int", "int64", "float64", "bool", "uuid", "time", "json", "jsonb", "file"] },
        "required": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "auto": { "type": "boolean" },
        "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "default": true,
        "relation": { "$ref": "#/$defs/ident" },
        "on_delete": { "enum": ["restrict", "cascade", "set_null"] },
        "on_update": { "enum": ["restrict", "cascade", "set_null"] },
        "references": { "$ref": "#/$defs/ident" },
        "renamed_from": { "$ref": "#/$defs/ident" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string", "maxLength": 200 },
        "format": { "enum": ["email", "uuid", "url", "date"] },
        "state_machine": { "$ref": "#/$defs/stateMachine" },
        "accept": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "max_bytes": { "type": "integer", "minimum": 1 }
      }
    },

    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial"],
      "properties": {
        "initial": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "minItems": 1, "items": { "type": "string" } }
          ]
        },
        "transitions": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "fk"],
      "properties": {
        "type": { "enum": ["has_many", "belongs_to", "many_to_many"] },
        "target": { "$ref": "#/$defs/ident" },
        "fk": { "$ref": "#/$defs/ident" },
        "through": { "type": "string", "pattern": "^[a-z][a-z0-9_\\-]*$" },
        "target_fk": { "$ref": "#/$defs/ident" },
        "limit": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "many_to_many" } } },
          "then": { "required": ["through", "target_fk"] },
          "else": { "properties": { "through": false, "target_fk": false } }
        }
      ]
    },

    "foreignKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "target", "ref_columns"],
      "properties": {
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ident" } },
        "target": { "$ref": "#/$defs/ident" },
        "ref_columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ident" } },
        "on_delete": { "enum": ["restrict", "cascade", "set_null"] },
        "on_update": { "enum": ["restrict", "cascade", "set_null"] }
      }
    },

    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ident" } },
        "unique": { "type": "boolean" },
        "method": { "enum": ["btree", "gin"] },
        "opclass": { "enum": ["jsonb_ops", "jsonb_path_ops"] }
      },
      "allOf": [
        {
          "if": { "required": ["opclass"] },
          "then": { "required": ["method"], "properties": { "method": { "const": "gin" } } }
        },
        {
          "if": { "required": ["method"], "properties": { "method": { "const": "gin" } } },
          "then": { "properties": { "unique": { "const": false } } }
        }
      ]
    },

    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before_create": { "$ref": "#/$defs/beforeHook" },
        "before_update": { "$ref": "#/$defs/beforeHook" },
        "after_create": { "$ref": "#/$defs/afterHook" },
        "after_update": { "$ref": "#/$defs/afterHook" }
      }
    },

    "beforeHook": {
      "type": "object",
      "description": "before_create/before_update hooks must be js or wasm (a before-hook decides the write synchronously; a webhook before-hook was never dispatched — rejected at load, ENG-19).",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["js", "wasm"] },
        "script": { "type": "string" },
        "wasm_module": { "type": "string" },
        "wasm_fn": { "type": "string" },
        "timeout": { "type": "string" }
      },
      "allOf": [
        { "if": { "required": ["type"], "properties": { "type": { "const": "js" } } },
          "then": { "required": ["script"], "properties": { "script": { "minLength": 1 } } } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "wasm" } } },
          "then": { "required": ["wasm_module"], "properties": { "wasm_module": { "minLength": 1 } } } }
      ]
    },

    "afterHook": {
      "type": "object",
      "description": "after_create/after_update hooks must be webhook (a sandboxed js/wasm hook post-commit is a no-op — rejected at load).",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "webhook" },
        "url": { "type": "string", "minLength": 1 },
        "script": { "type": "string" },
        "hmac_secret_env": { "type": "string" },
        "wasm_module": { "type": "string" },
        "wasm_fn": { "type": "string" },
        "timeout": { "type": "string" }
      }
    },

    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/role" }
        }
      }
    },

    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "oneOf": [
            { "const": "*" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "actions": { "type": "array", "items": { "type": "string" } },
        "conditions": { "$ref": "#/$defs/condition" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/ident" } },
        "permissions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/permission" }
        },
        "routes": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_\\-]*$" },
          "additionalProperties": { "$ref": "#/$defs/routeGrant" }
        }
      },
      "oneOf": [
        {
          "title": "per-resource form",
          "required": ["permissions"],
          "not": { "anyOf": [
            { "required": ["resources"] },
            { "required": ["actions"] },
            { "required": ["conditions"] },
            { "required": ["fields"] }
          ] }
        },
        {
          "title": "role-global (legacy) form",
          "not": { "required": ["permissions"] }
        }
      ]
    },

    "routeGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["read", "create", "update", "delete", "*"] }
        }
      }
    },

    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "dependentRequired": { "condition_actions": ["conditions"] },
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["read", "create", "update", "delete", "*"] }
        },
        "conditions": { "$ref": "#/$defs/condition" },
        "condition_actions": {
          "type": "array",
          "items": { "enum": ["read", "create", "update", "delete"] }
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/ident" } }
      }
    },

    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "op": { "enum": ["eq", ""] },
        "val": { "type": "string" }
      }
    },

    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "event": { "type": "string" },
            "resource": { "type": "string" },
            "cron": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "ref": { "type": "string" },
              "config": true,
              "next": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
