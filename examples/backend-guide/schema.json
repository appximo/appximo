{
  "$schema": "https://appximo.com/schema/v1",
  "version": "1",
  "name": "courses-api",
  "resources": {
    "students": {
      "fields": {
        "user_id":   { "type": "uuid",   "unique": true },
        "full_name": { "type": "string", "required": true, "maxLength": 120 },
        "country":   { "type": "string" },
        "plan":      { "type": "string", "enum": ["free", "pro"], "default": "free" },
        "created_at":{ "type": "time",   "auto": true }
      },
      "indexes": [{ "fields": ["user_id"] }]
    },
    "courses": {
      "fields": {
        "title":       { "type": "string", "required": true, "maxLength": 200 },
        "price_cents": { "type": "int64",  "min": 0 },
        "published":   { "type": "bool",   "default": false },
        "metadata":    { "type": "jsonb",  "default": {} }
      },
      "indexes": [
        { "fields": ["published"] },
        { "fields": ["metadata"], "method": "gin", "opclass": "jsonb_path_ops" }
      ]
    },
    "enrollments": {
      "fields": {
        "user_id":     { "type": "uuid" },
        "course_id":   { "type": "uuid",   "relation": "courses", "on_delete": "restrict" },
        "amount_cents":{ "type": "int64",   "min": 0 },
        "external_ref":{ "type": "string",  "unique": true },
        "status": {
          "type": "string",
          "enum": ["active", "refunded"],
          "default": "active",
          "state_machine": {
            "initial": "active",
            "transitions": { "active": ["refunded"], "refunded": [] }
          }
        },
        "created_at":  { "type": "time", "auto": true }
      },
      "events": ["create"],
      "indexes": [{ "fields": ["user_id"] }]
    },
    "webhook_events": {
      "fields": {
        "event_id":   { "type": "string", "required": true, "unique": true, "maxLength": 160 },
        "provider":   { "type": "string", "required": true, "maxLength": 40 },
        "payload":    { "type": "text" },
        "created_at": { "type": "time", "auto": true }
      }
    }
  },
  "rbac": {
    "roles": {
      "admin": { "resources": "*", "actions": ["*"] },
      "student": {
        "permissions": {
          "students":    { "actions": ["read", "update"], "conditions": { "field": "user_id", "op": "eq", "val": "$user_id" } },
          "courses":     { "actions": ["read"] },
          "enrollments": { "actions": ["read", "create"], "conditions": { "field": "user_id", "op": "eq", "val": "$user_id" } }
        },
        "routes": { "checkout": { "actions": ["create"] } }
      }
    }
  }
}
