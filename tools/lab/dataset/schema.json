{
  "$schema": "https://appitools.dev/schema/v1",
  "version": "1",
  "name": "commerce-core",
  "resources": {
    "tipos_producto": {
      "fields": {
        "nombre": {
          "type": "string",
          "required": true,
          "maxLength": 80,
          "unique": true,
          "minLength": 1
        },
        "vertical": {
          "type": "string",
          "enum": [
            "retail",
            "alimentos",
            "servicios"
          ],
          "default": "retail"
        },
        "regimen_iva": {
          "type": "string",
          "enum": [
            "gravado",
            "exento",
            "excluido"
          ],
          "default": "gravado"
        },
        "tarifa_iva_pct": {
          "type": "int",
          "min": 0,
          "max": 100,
          "default": 19
        },
        "atributos_def": {
          "type": "json"
        },
        "activo": {
          "type": "bool",
          "default": true
        },
        "created_at": {
          "type": "time",
          "auto": true
        }
      },
      "indexes": [
        {
          "fields": [
            "vertical"
          ]
        }
      ]
    },
    "categorias": {
      "fields": {
        "nombre": {
          "type": "string",
          "required": true,
          "maxLength": 100,
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "required": true,
          "maxLength": 100,
          "unique": true,
          "minLength": 1
        },
        "parent_id": {
          "type": "uuid",
          "relation": "categorias",
          "on_delete": "set_null"
        },
        "orden": {
          "type": "int",
          "default": 0
        },
        "activa": {
          "type": "bool",
          "default": true
        }
      },
      "indexes": [
        {
          "fields": [
            "parent_id"
          ]
        },
        {
          "fields": [
            "activa"
          ]
        }
      ]
    },
    "productos": {
      "fields": {
        "nombre": {
          "type": "string",
          "required": true,
          "maxLength": 200,
          "minLength": 1
        },
        "descripcion": {
          "type": "text"
        },
        "sku": {
          "type": "string",
          "required": true,
          "maxLength": 64,
          "unique": true,
          "minLength": 1
        },
        "precio_centavos": {
          "type": "int64",
          "required": true,
          "min": 0
        },
        "tipo_producto_id": {
          "type": "uuid",
          "relation": "tipos_producto",
          "on_delete": "restrict"
        },
        "categoria_id": {
          "type": "uuid",
          "relation": "categorias",
          "on_delete": "set_null"
        },
        "imagen_id": {
          "type": "file",
          "on_delete": "set_null",
          "accept": "image",
          "max_bytes": 5242880
        },
        "atributos": {
          "type": "jsonb",
          "default": {}
        },
        "destacado": {
          "type": "bool",
          "default": false
        },
        "estado": {
          "type": "string",
          "enum": [
            "borrador",
            "activo",
            "archivado"
          ],
          "default": "borrador",
          "state_machine": {
            "initial": "borrador",
            "transitions": {
              "borrador": [
                "activo",
                "archivado"
              ],
              "activo": [
                "borrador",
                "archivado"
              ],
              "archivado": []
            }
          }
        },
        "created_at": {
          "type": "time",
          "auto": true
        },
        "updated_at": {
          "type": "time",
          "auto": true
        }
      },
      "relations": {
        "variantes": {
          "type": "has_many",
          "target": "variantes",
          "fk": "producto_id",
          "limit": 50
        },
        "categoria": {
          "type": "belongs_to",
          "target": "categorias",
          "fk": "categoria_id"
        },
        "tipo": {
          "type": "belongs_to",
          "target": "tipos_producto",
          "fk": "tipo_producto_id"
        }
      },
      "indexes": [
        {
          "fields": [
            "estado",
            "created_at"
          ]
        },
        {
          "fields": [
            "categoria_id"
          ]
        },
        {
          "fields": [
            "tipo_producto_id"
          ]
        },
        {
          "fields": [
            "atributos"
          ],
          "method": "gin",
          "opclass": "jsonb_path_ops"
        }
      ]
    },
