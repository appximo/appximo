        "linea1": {
          "type": "string",
          "required": true,
          "maxLength": 200,
          "minLength": 1
        },
        "ciudad": {
          "type": "string",
          "required": true,
          "maxLength": 80,
          "minLength": 1
        },
        "departamento": {
          "type": "string",
          "maxLength": 80
        },
        "codigo_postal": {
          "type": "string",
          "maxLength": 20
