        "total_centavos": {
          "type": "int64",
          "required": true,
          "min": 0
        },
        "cupon_id": {
          "type": "uuid",
          "relation": "cupones",
          "on_delete": "set_null"
        },
        "descuento_centavos": {
          "type": "int64",
          "default": 0,
          "min": 0
        },
        "moneda": {
          "type": "string",
          "maxLength": 3,
          "default": "COP"
        },
        "created_at": {
          "type": "time",
          "auto": true
        },
        "updated_at": {
          "type": "time",
          "auto": true
        }
      },
      "relations": {
        "lineas": {
          "type": "has_many",
          "target": "orden_lineas",
          "fk": "orden_id",
          "limit": 100
