    "ordenes": {
      "fields": {
        "numero": {
          "type": "string",
          "required": true,
          "maxLength": 32,
          "unique": true,
          "minLength": 1
        },
        "cliente_id": {
          "type": "uuid",
          "relation": "clientes",
          "on_delete": "restrict"
        },
        "user_id": {
          "type": "uuid"
        },
        "estado": {
          "type": "string",
          "enum": [
            "creada",
            "pendiente_pago",
            "pagada",
            "preparando",
            "enviada",
            "entregada",
            "cerrada",
            "cancelada",
            "reembolsada"
          ],
          "default": "creada",
          "state_machine": {
            "initial": "creada",
            "transitions": {
              "creada": [
                "pendiente_pago",
                "cancelada"
              ],
              "pendiente_pago": [
                "pagada",
                "cancelada"
              ],
              "pagada": [
                "preparando",
                "reembolsada",
                "cancelada"
              ],
              "preparando": [
                "enviada",
                "cancelada"
              ],
              "enviada": [
                "entregada"
              ],
              "entregada": [
                "cerrada",
                "reembolsada"
              ],
              "cerrada": [],
              "cancelada": [],
              "reembolsada": []
            }
          }
        },
        "subtotal_centavos": {
          "type": "int64",
          "required": true,
          "min": 0
        },
        "impuestos_centavos": {
          "type": "int64",
          "default": 0,
          "min": 0
        },
        "envio_centavos": {
          "type": "int64",
          "default": 0,
          "min": 0
        },
        "envio_metodo": {
          "type": "string",
          "enum": [
            "retiro",
            "envio"
          ],
          "default": "retiro"
        },
        "direccion_id": {
          "type": "uuid",
          "relation": "direcciones",
          "on_delete": "set_null"
