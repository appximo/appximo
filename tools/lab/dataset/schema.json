          "default": "activa",
          "state_machine": {
            "initial": "activa",
            "transitions": {
              "activa": [
                "confirmada",
                "liberada"
              ],
              "confirmada": [],
              "liberada": []
            }
          }
        },
        "expira_en": {
          "type": "time",
          "required": true
        },
        "created_at": {
          "type": "time",
          "auto": true
        }
