      "fields": {
        "producto_id": {
          "type": "uuid",
          "relation": "productos",
          "on_delete": "cascade"
        },
        "sku": {
          "type": "string",
          "required": true,
          "maxLength": 64,
          "unique": true,
          "minLength": 1
        },
        "nombre": {
          "type": "string",
          "required": true,
          "maxLength": 120,
          "minLength": 1
        },
        "precio_centavos": {
          "type": "int64",
          "required": true,
          "min": 0
        },
        "stock": {
          "type": "int",
          "required": true,
          "default": 0,
          "min": 0
        },
        "stock_reservado": {
          "type": "int",
          "required": true,
          "default": 0,
          "min": 0
        },
        "activa": {
          "type": "bool",
          "default": true
        },
        "opciones": {
          "type": "jsonb",
          "default": {}
        },
        "created_at": {
          "type": "time",
          "auto": true
        }
      },
      "indexes": [
        {
          "fields": [
            "producto_id"
          ]
        },
        {
          "fields": [
            "activa"
          ]
        },
        {
          "fields": [
            "opciones"
          ],
          "method": "gin",
          "opclass": "jsonb_path_ops"
        }
      ]
    },
    "reservas_stock": {
      "fields": {
        "variante_id": {
          "type": "uuid",
          "relation": "variantes",
          "on_delete": "cascade"
        },
        "orden_id": {
          "type": "uuid"
        },
        "cantidad": {
          "type": "int",
          "required": true,
          "min": 1
        },
