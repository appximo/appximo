# Copy to .env and fill in real values:  cp .env.example .env
# docker compose reads these. NEVER commit your real .env (it is gitignored).

# ── Required by both compose files ───────────────────────────────────────────
# HS256 signing secret for tenant JWTs — minimum 32 characters, generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_minimum_32_characters_long_secret
# X-Admin-Key for /metrics, /debug, /admin and the control plane.
ADMIN_KEY=CHANGE_ME_admin_key
# Postgres password (used by both the db service and the engine's DATABASE_URL).
DB_PASSWORD=CHANGE_ME_db_password

# ── Production only (docker-compose.prod.yml) ────────────────────────────────
# Public domain pointing at this server (Caddy issues its TLS certificate).
DOMAIN=api.example.com
# Email Let's Encrypt uses for certificate-expiry notices.
ACME_EMAIL=you@example.com

# ── Optional UI profile (docker compose --profile ui up) ─────────────────────
NEXTAUTH_SECRET=CHANGE_ME_nextauth_secret
