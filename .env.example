# Copy to .env and fill in real values:  cp .env.example .env
# docker compose reads these. NEVER commit your real .env (it is gitignored).

# ── Required by both compose files ───────────────────────────────────────────
# HS256 signing secret for tenant JWTs — minimum 32 characters, generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_minimum_32_characters_long_secret
# X-Admin-Key for /metrics, /debug, /admin and the control plane.
ADMIN_KEY=CHANGE_ME_admin_key
# Postgres password (used by both the db service and the engine's DATABASE_URL).
DB_PASSWORD=CHANGE_ME_db_password

# ── Production only (docker-compose.prod.yml) ────────────────────────────────
# Public domain pointing at this server (Caddy issues its TLS certificate).
DOMAIN=api.example.com
# Email Let's Encrypt uses for certificate-expiry notices.
ACME_EMAIL=you@example.com

# ── Background worker (the `worker` service in both compose files) ───────────
# All optional — the worker runs in safe "echo" mode with these defaults.
# echo = log+ack | writeback = demo status PATCH | xlsx = FileJob consumer | email = transactional email.
APPXIMO_WORKER_MODE=echo
# Scoped service role the worker assumes to write back (NEVER admin). Must exist
# in your schema's RBAC for writeback/xlsx modes (echo needs nothing).
APPXIMO_WORKER_ROLE=service_worker
# Internal Host-header suffix for the worker→engine API call ({tenant}.{suffix}).
# The engine reads the tenant from the subdomain, so "localhost" is correct even
# in production — this is NOT a DNS name. Leave as-is unless you know you need it.
APPXIMO_TENANT_DOMAIN=localhost

# ── Email worker (APPXIMO_WORKER_MODE=email) — EXTERNAL SMTP provider ───────
# Provider-agnostic SMTP (Brevo / Resend / Mailgun / SES …): only these change.
# Self-hosting SMTP is not supported — deliverability/SPF/DKIM is a provider's job.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=My App <no-reply@myapp.com>
SMTP_USER=
SMTP_PASS=

# ── Optional UI profile (docker compose --profile ui up) ─────────────────────
NEXTAUTH_SECRET=CHANGE_ME_nextauth_secret
