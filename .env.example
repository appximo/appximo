# Copy to .env and fill in real values:  cp .env.example .env
# docker-compose reads these. NEVER commit your real .env (it is gitignored).

# Required — the engine refuses to start without these.
JWT_SECRET=your-secret-key-minimum-32-characters
ADMIN_KEY=your-admin-key

# Postgres password (used by both the db service and the engine's DATABASE_URL).
DB_PASSWORD=changeme

# Only needed when running the optional UI profile (docker compose --profile ui up).
NEXTAUTH_SECRET=your-nextauth-secret
